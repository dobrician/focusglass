#!/bin/bash
# Sets focusglass up in your Hyprland config, or takes it out.
#
#   focusglass-setup ensure     ask once to set it up, when it isn't yet (run by the Omarchy service)
#   focusglass-setup install    add ~/.config/hypr/focusglass.lua and load it from hyprland.lua
#   focusglass-setup uninstall  stop loading it and give Hyprland its own window shader back

set -o pipefail

PLUGIN_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
SELF="$PLUGIN_DIR/omarchy/focusglass-setup"
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/focusglass
HYPR=$HOME/.config/hypr
CONFIG=$HYPR/focusglass.lua
MAIN=$HYPR/hyprland.lua
SHADER=$HYPR/shaders/surface.frag
REQUIRE='require("hypr.focusglass")'

loaded_from_main() { grep -q "^[[:space:]]*$REQUIRE" "$MAIN" 2>/dev/null; }

# Opens a terminal to set up at most once, so a "no" doesn't come back at every login.
ask_once() {
  mkdir -p "$STATE"
  [[ -f $STATE/asked ]] && return
  touch "$STATE/asked"
  omarchy-launch-floating-terminal-with-presentation "bash '$SELF' install"
}

# Loads focusglass right after the look'n'feel overrides, so its values win over them.
add_require() {
  if grep -q '^require("hypr.looknfeel")' "$MAIN"; then
    sed -i "/^require(\"hypr.looknfeel\")/a $REQUIRE" "$MAIN"
  else
    printf '\n%s\n' "$REQUIRE" >>"$MAIN"
  fi
}

case ${1:-} in
ensure)
  [[ -f $CONFIG ]] && loaded_from_main || ask_once
  ;;
install)
  echo "focusglass fades the windows you are not using: grayscale, darker, frosted"
  echo "and see-through, so the active window stands out."
  echo
  [[ -f $MAIN ]] || { echo "No $MAIN: focusglass needs Hyprland's Lua config."; exit 1; }

  if [[ -f $CONFIG ]]; then
    echo "Keeping your settings in $CONFIG."
  else
    cp "$PLUGIN_DIR/examples/focusglass.lua" "$CONFIG"
    echo "Added your settings file: $CONFIG"
  fi

  if ! loaded_from_main; then
    if gum confirm "Load focusglass from ~/.config/hypr/hyprland.lua?"; then
      cp "$MAIN" "$MAIN.bak.focusglass-$(date +%Y%m%dT%H%M%S)"
      add_require
    else
      echo
      echo "Not loaded. To turn it on later, add this line to hyprland.lua:"
      echo "  $REQUIRE"
      exit 0
    fi
  fi

  hyprctl reload >/dev/null
  echo
  echo "focusglass is on. Change how it looks in $CONFIG;"
  echo "every effect goes from 0 (off) to 100, and saving applies it."
  ;;
uninstall)
  if loaded_from_main; then
    cp "$MAIN" "$MAIN.bak.focusglass-$(date +%Y%m%dT%H%M%S)"
    sed -i "\|^[[:space:]]*$REQUIRE|d" "$MAIN"
  fi
  if grep -q "Generated by focusglass" "$SHADER" 2>/dev/null; then
    rm -f "$SHADER"
  fi
  rm -rf "$STATE"
  hyprctl reload >/dev/null
  hyprctl reloadshaders >/dev/null
  echo "focusglass is off and Hyprland draws windows with its own shader again."
  echo "Your settings stay in $CONFIG; delete it if you don't want it."
  echo "Remove the plugin itself with: omarchy plugin remove dc.focusglass"
  ;;
*)
  sed -n '2,6p' "$SELF" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
